---
import "../styles/global.css";
import { contactLinks, site } from "../data/site";
import SpeedInsights from "@vercel/speed-insights/astro";
import Analytics from "@vercel/analytics/astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = site.defaultTitle,
  description = site.home.description.join(" "),
  image = "/og-default.png",
} = Astro.props;
const canonical = new URL(
  Astro.url.pathname,
  Astro.site ?? "https://www.franckkouby.fr"
).toString();
const imageUrl = new URL(image, Astro.site ?? "https://www.franckkouby.fr").toString();
---

<html lang="fr" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="robots" content="index,follow" />
  </head>
  <body
    class="bg-[#101010] text-[#f5f1e8] antialiased min-h-screen flex flex-col text-sm font-[-apple-system,BlinkMacSystemFont,'Segoe_UI',Noto_Sans,Helvetica,Arial,sans-serif,'Apple_Color_Emoji','Segoe_UI_Emoji']"
  >
    <header class="site-header w-full bg-[#171717] border-b border-[#3b3b3b]">
      <div
        class="max-w-328 mx-auto px-4 py-2.5 sm:py-0 sm:h-12 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2.5 sm:gap-4"
      >
        <!-- Name à gauche -->
        <a
          href="/"
          class="flex items-center rounded-md px-2 py-1 -ml-2 text-[#f5f1e8] hover:bg-[#292929] hover:text-[#f2a33a] transition-colors"
        >
          <span class="font-bold text-base tracking-tight">{site.name}</span>
        </a>
      </div>
    </header>
  </body>

  <main
    class="flex-1
            max-w-328
            mx-auto
            w-full
            px-4
            py-6"
  >
    <div
      class="bg-[#171717] border border-[#3b3b3b] rounded-md p-5 shadow-sm text-[14px] leading-relaxed print-border-remove"
    >
      <slot />
    </div>
  </main>

  <footer class="mt-auto border-t border-[#3b3b3b] bg-[#101010]">
    <div
      class="max-w-5xl mx-auto px-4 py-4 flex items-center justify-between text-[12px] text-[#a9a39a]"
    >
      <div class="flex items-center gap-2">
        <span>© {new Date().getFullYear()} {site.name}</span>
      </div>
      <nav class="flex gap-3">
        {
          contactLinks.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="text-[#f2a33a] hover:underline"
            >
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>
  </footer>
  <Analytics />
  <SpeedInsights />
</html>
