---
import Badge from "../components/Badge.astro";
import HomeSidebarItem from "../components/HomeSidebarItem.astro";
import Layout from "../layouts/Layout.astro";
import { getEntry, render } from "astro:content";
import { site } from "../data/site";
import { formatDateFr, getPublishedCollection, sortByDateDesc } from "../lib/content";
import { getThumbnail } from "../lib/images";
const articles = sortByDateDesc(await getPublishedCollection("articles"));
const featuredArticles = articles.slice(0, 5);
const articlesWithImages = await Promise.all(
  featuredArticles.map(async (article) => ({
    article,
    img: await getThumbnail("articles", article),
  }))
);
const artistPage = await getEntry("pages", "franck-kouby-officiel");
const albumPage = await getEntry("pages", "album-de-franck-kouby");
if (!artistPage || !albumPage) {
  throw new Error("Les pages principales de Franck Kouby sont introuvables.");
}
const { Content: ArtistContent } = await render(artistPage);
const { Content: AlbumContent } = await render(albumPage);
---

<Layout>
  <section class="pb-6 mb-6 border-b border-[#d0d7de]">
    <div class="flex flex-col">
      <div>
        <h1 class="text-2xl font-semibold text-[#1f2328] tracking-tight">
          {site.tagline}
        </h1>
        <div class="mt-1">
          <Badge variant="home">{site.home.badge}</Badge>
        </div>
        <div class="mt-2 space-y-3 text-[14px] text-[#57606a] leading-relaxed">
          {
            site.home.description.map((paragraph) => (
              <p set:html={paragraph.replace(/\*\*(.*?)\*\*/g, "<strong>$1</strong>")} />
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <section class="lg:col-span-2 border border-[#d0d7de] rounded-md bg-white overflow-hidden">
      <div class="p-4 prose prose-sm max-w-none text-[#1f2328] markdown-body">
        <AlbumContent />
        <ArtistContent />
      </div>
    </section>

    <section class="border border-[#d0d7de] rounded-md bg-white overflow-hidden">
      <div
        class="bg-[#f6f8fa] border-b border-[#d0d7de] px-4 py-2 flex items-center justify-between"
      >
        <span class="text-xs font-semibold text-[#1f2328]">Dernières publications</span>
        <a href="/articles" class="text-[11px] text-[#0969da] hover:underline"> Voir tout </a>
      </div>
      <div class="divide-y divide-[#d0d7de]">
        {
          articlesWithImages.map(({ article, img }) => (
            <HomeSidebarItem
              href={`/articles/${article.id}`}
              title={article.data.title}
              thumbnail={img ?? undefined}
            >
              <span slot="badge" class="text-[11px] text-[#636c76] whitespace-nowrap">
                {formatDateFr(article.data.date)}
              </span>
            </HomeSidebarItem>
          ))
        }
      </div>
    </section>
  </div>
</Layout>
