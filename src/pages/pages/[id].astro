---
import { getEntry, render } from "astro:content";
import ContentHeader from "../../components/ContentHeader.astro";
import MarkdownImages from "../../components/MarkdownImages.astro";
import Layout from "../../layouts/Layout.astro";
import { getPublishedCollection } from "../../lib/content";

export const prerender = true;

export async function getStaticPaths() {
  const pages = await getPublishedCollection("pages");
  return pages.map((page) => ({
    params: { id: page.id },
    props: { page },
  }));
}

const page =
  Astro.props.page ?? (Astro.params.id ? await getEntry("pages", Astro.params.id) : undefined);
if (!page) {
  return Astro.redirect("/404");
}

const { Content } = await render(page);
---

<Layout title={page.data.title} description={page.data.description}>
  <article class="space-y-6">
    <ContentHeader href="/" label="Accueil" current={page.id} title={page.data.title} />
    <div class="prose prose-sm max-w-none text-[#1f2328] space-y-4 markdown-body">
      <Content />
    </div>
    <MarkdownImages />
  </article>
</Layout>
