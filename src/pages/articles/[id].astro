---
import Badge from "../../components/Badge.astro";
import ContentHeader from "../../components/ContentHeader.astro";
import MarkdownImages from "../../components/MarkdownImages.astro";
import { getEntry, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { formatDateFr } from "../../lib/content";

const id = Astro.params.id;
if (!id) {
  return Astro.redirect("/404");
}

const article = await getEntry("articles", id);
if (!article) {
  return Astro.redirect("/404");
}

const { data } = article;
const { Content } = await render(article);
const formattedDate = formatDateFr(data.date);
---

<Layout title={data.title}>
  <article class="space-y-6">
    <ContentHeader href="/articles" label="Articles" current={article.id} title={data.title}>
      <span slot="meta" class="font-medium text-[#1f2328]">{formattedDate}</span>
      {
        data.tags &&
          data.tags.length > 0 &&
          data.tags.map((tag: string) => (
            <Badge slot="meta" variant="tag">
              {tag}
            </Badge>
          ))
      }
    </ContentHeader>

    <div class="prose prose-sm max-w-none text-[#1f2328] space-y-4 markdown-body">
      <Content />
    </div>
    <MarkdownImages />
  </article>
</Layout>
